APP_NAME=MitraPesisir
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- MySQL 8 / MariaDB 10.6+ ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pesisir_db
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+07:00

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

BCRYPT_ROUNDS=12
